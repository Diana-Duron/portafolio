---
// src/components/Navbar.astro
import { withBase } from '../utils/url';
---

<!-- Barra de Navegación Estilo Bauhaus -->
<nav
    class="fixed top-0 left-0 w-full z-40 border-b-bauhaus border-deep-purple dark:border-pastel-pink bg-light-bg dark:bg-dark-bg flex justify-between items-center p-4 md:px-12 shadow-sm transition-colors duration-300"
>
    <a href={withBase('/#home')} class="flex items-center space-x-3 group">
        <img
            src={withBase('/logo.png')}
            alt="DD.DATA Logo"
            class="h-10 md:h-12 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div
            class="text-2xl md:text-3xl font-bauhaus font-bold tracking-widest uppercase text-deep-purple dark:text-light-bg hidden sm:block"
        >
            DIANA<span class="text-pastel-pink stroke-bauhaus">DURÓN</span>
        </div>
    </a>
    <div class="flex items-center space-x-6 md:space-x-12">
        <ul
            class="font-bauhaus text-lg uppercase font-bold hidden md:flex space-x-8"
        >
            <li>
                <a
                    href={withBase('/#home')}
                    class="hover:bg-pastel-purple hover:text-deep-purple dark:hover:bg-pastel-pink dark:hover:text-dark-bg px-2 transition-colors"
                    >Inicio</a>
            </li>
            <li>
                <a
                    href={withBase('/#experience')}
                    class="hover:bg-pastel-pink hover:text-deep-purple dark:hover:bg-pastel-purple dark:hover:text-dark-bg px-2 transition-colors"
                    >Experiencia</a>
            </li>
            <li>
                <a
                    href={withBase('/#work')}
                    class="hover:bg-pastel-purple hover:text-deep-purple dark:hover:bg-pastel-pink dark:hover:text-dark-bg px-2 transition-colors"
                    >Proyectos</a>
            </li>
            <li>
                <a
                    href={withBase('/#blog')}
                    class="hover:bg-pastel-pink hover:text-deep-purple dark:hover:bg-pastel-purple dark:hover:text-dark-bg px-2 transition-colors"
                    >Blog</a>
            </li>
            <li>
                <a
                    href={withBase('/perfil')}
                    class="hover:bg-pastel-purple hover:text-deep-purple dark:hover:bg-pastel-pink dark:hover:text-dark-bg px-2 transition-colors border-l-2 border-deep-purple dark:border-pastel-pink ml-2 pl-4"
                    >Perfil</a>
            </li>
        </ul>

        <!-- Botón Dark Mode -->
        <button
            onclick="toggleTheme(event)"
            class="border-2 border-deep-purple dark:border-pastel-pink p-2 bg-pastel-pink dark:bg-dark-surface hover:bg-pastel-purple dark:hover:bg-pastel-pink transition-colors group relative overflow-hidden"
        >
            <!-- Icono de Sol / Luna Mixto -->
            <svg
                class="w-6 h-6 text-deep-purple dark:text-pastel-pink group-hover:dark:text-dark-bg relative z-10"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="square"
                    stroke-linejoin="miter"
                    stroke-width="2"
                    d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                ></path>
            </svg>
        </button>

        <button id="mobile-menu-btn" class="md:hidden border-2 border-deep-purple dark:border-pastel-pink p-2 bg-pastel-pink dark:bg-dark-surface hover:bg-pastel-purple transition-colors">
            <svg class="w-6 h-6 text-deep-purple dark:text-pastel-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="3" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>
</nav>

<!-- Menú Móvil -->
<div id="mobile-menu" class="fixed inset-0 bg-light-bg dark:bg-dark-bg z-30 hidden flex-col items-center justify-center pt-20 border-b-8 border-deep-purple dark:border-pastel-pink transition-colors">
    <ul class="font-bauhaus text-3xl uppercase font-bold text-center space-y-8">
        <li><a href={withBase('/#home')} class="mobile-link hover:text-pastel-purple dark:hover:text-pastel-pink transition-colors">Inicio</a></li>
        <li><a href={withBase('/#experience')} class="mobile-link hover:text-pastel-purple dark:hover:text-pastel-pink transition-colors">Experiencia</a></li>
        <li><a href={withBase('/#work')} class="mobile-link hover:text-pastel-purple dark:hover:text-pastel-pink transition-colors">Proyectos</a></li>
        <li><a href={withBase('/#blog')} class="mobile-link hover:text-pastel-purple dark:hover:text-pastel-pink transition-colors">Blog</a></li>
        <li><a href={withBase('/perfil')} class="mobile-link hover:text-pastel-purple dark:hover:text-pastel-pink transition-colors">Perfil</a></li>
    </ul>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const links = document.querySelectorAll('.mobile-link');

        if (btn && menu) {
            btn.addEventListener('click', () => {
                menu.classList.toggle('hidden');
                menu.classList.toggle('flex');
                document.body.classList.toggle('overflow-hidden');
            });

            // Cerrar el menú al hacer clic en un enlace
            links.forEach(link => {
                link.addEventListener('click', () => {
                    menu.classList.add('hidden');
                    menu.classList.remove('flex');
                    document.body.classList.remove('overflow-hidden');
                });
            });
        }
    });
</script>
