---
// src/components/Contact.astro
---

<!-- Sección 4: Contacto -->
<section id="contact" class="min-h-screen relative flex items-center justify-center p-8 bg-pastel-pink dark:bg-dark-bg transition-colors duration-300">
    <div class="absolute inset-0 opacity-10 bg-pattern-dots transition-all"></div>
    
    <div class="relative z-10 max-w-4xl w-full bg-white dark:bg-dark-surface border-bauhaus border-deep-purple dark:border-pastel-pink shadow-[20px_20px_0px_0px_#E6E6FA] dark:shadow-[20px_20px_0px_0px_#FFD1DC] p-8 md:p-16 text-center transition-all">
        <h2 class="font-bauhaus text-5xl md:text-7xl uppercase text-deep-purple dark:text-light-bg mb-6">Iniciar un<br>Análisis</h2>
        <p class="font-body text-xl mb-12 max-w-2xl mx-auto">¿Necesitas extraer el verdadero valor de tus datos financieros y optimizar decisiones? Hablemos de SQL y estrategias de crédito.</p>
        
        <form id="contact-form" class="space-y-6 max-w-xl mx-auto text-left">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col">
                    <label class="font-bauhaus uppercase font-bold mb-2">Nombre</label>
                    <input type="text" id="name" name="name" required class="border-2 border-deep-purple dark:border-pastel-pink bg-light-bg dark:bg-dark-bg dark:text-light-bg p-3 focus:outline-none focus:bg-pastel-purple dark:focus:bg-deep-purple transition-colors">
                </div>
                <div class="flex flex-col">
                    <label class="font-bauhaus uppercase font-bold mb-2">Email</label>
                    <input type="email" id="email" name="email" required class="border-2 border-deep-purple dark:border-pastel-pink bg-light-bg dark:bg-dark-bg dark:text-light-bg p-3 focus:outline-none focus:bg-pastel-purple dark:focus:bg-deep-purple transition-colors">
                </div>
            </div>
            <div class="flex flex-col">
                <label class="font-bauhaus uppercase font-bold mb-2">Mensaje</label>
                <textarea id="message" name="message" rows="4" required class="border-2 border-deep-purple dark:border-pastel-pink bg-light-bg dark:bg-dark-bg dark:text-light-bg p-3 focus:outline-none focus:bg-pastel-pink dark:focus:bg-deep-purple transition-colors resize-none"></textarea>
            </div>
            <button type="submit" id="submit-btn" class="w-full bg-deep-purple dark:bg-pastel-pink text-pastel-pink dark:text-dark-bg font-bauhaus font-bold text-2xl uppercase py-4 border-4 border-transparent hover:bg-white dark:hover:bg-transparent dark:hover:text-pastel-pink hover:text-deep-purple hover:border-deep-purple dark:hover:border-pastel-pink transition-all shadow-[8px_8px_0px_0px_#E6E6FA] dark:shadow-[8px_8px_0px_0px_#3B1C4A]">
                Enviar Datos
            </button>
            <p id="form-status" class="hidden font-body text-lg font-bold text-center mt-4 p-4"></p>
        </form>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('contact-form') as HTMLFormElement;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
        const statusEl = document.getElementById('form-status') as HTMLParagraphElement;

        if (!form) return;

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Enviando...';
            statusEl.className = 'hidden';

            const formData = new FormData(form);
            const name = formData.get('name');
            const email = formData.get('email');
            const message = formData.get('message');

            const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID;

            if (!FORMSPREE_ID || FORMSPREE_ID === 'coloqua_tu_id_aqui') {
                console.error('Falta el ID de Formspree');
                statusEl.textContent = 'Error: No se ha configurado el ID de Formspree.';
                statusEl.className = 'font-body text-lg font-bold text-center mt-4 bg-red-100 text-red-800 border-2 border-red-800 block p-4';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Enviar Datos';
                return;
            }

            try {
                const payload = {
                    name: name,
                    email: email,
                    message: message,
                    subject: `Nuevo mensaje de portafolio de: ${name}`
                };

                const response = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok) {
                    statusEl.textContent = '¡Mensaje enviado con éxito! Te contactaré pronto.';
                    statusEl.className = 'font-body text-lg font-bold text-center mt-4 bg-green-100 text-green-800 border-2 border-green-800 block p-4';
                    form.reset();
                } else {
                    if (Object.hasOwn(data, 'errors')) {
                        throw new Error(data["errors"].map((error: any) => error["message"]).join(", "));
                    } else {
                        throw new Error('Error al enviar');
                    }
                }
            } catch (err: any) {
                console.error('Formspree Error:', err);
                statusEl.textContent = 'Hubo un error al enviar el mensaje. Intenta más tarde.';
                statusEl.className = 'font-body text-lg font-bold text-center mt-4 bg-red-100 text-red-800 border-2 border-red-800 block p-4';
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Enviar Datos';
            }
        });
    });
</script>
